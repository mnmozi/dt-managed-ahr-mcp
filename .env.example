# Dynatrace Managed cluster base URL (no trailing slash, no env path)
# e.g. https://localhost:8080  or  https://dt.example.com
DT_CLUSTER_URL=

# Environment UUID (the ID in /e/<uuid>/ URLs)
DT_ENV_ID=

# API token — provide EXACTLY ONE of the following two (not both):
#   DT_TOKEN       — the token value directly
#   DT_TOKEN_FILE  — absolute path to a gitignored file with the token on a single line
# Scope needed: ReadConfig (at minimum) + entities.read for entity tools.
# DT_TOKEN=
DT_TOKEN_FILE=

# Optional cluster token (only needed for /api/cluster/* calls).
# Same "exactly one" rule: DT_CLUSTER_TOKEN or DT_CLUSTER_TOKEN_FILE.
# DT_CLUSTER_TOKEN=
# DT_CLUSTER_TOKEN_FILE=

# Set to "0" to disable TLS cert verification (self-signed localhost clusters).
# Any other value (or unset) = verification ON.
DT_TLS_VERIFY=1
