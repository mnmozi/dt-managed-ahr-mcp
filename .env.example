# ---------------------------------------------------------------------------
# dt-managed-mcp — environment configuration
# Copy to .env (gitignored) or pass as `env` in your MCP client config.
# ---------------------------------------------------------------------------

# Dynatrace Managed cluster base URL (no trailing slash, no /e/<env> path)
# e.g. https://localhost:8080  or  https://dt.example.com
DT_CLUSTER_URL=

# Environment UUID (the ID in /e/<uuid>/ URLs)
DT_ENV_ID=

# ---- Read token (required) — provide EXACTLY ONE of the two forms ----------
#   DT_TOKEN       — the token value directly
#   DT_TOKEN_FILE  — absolute path to a gitignored file with the token on one line
# Scopes (see README "Token scopes"): settings.read, ReadConfig, entities.read,
# metrics.read, events.read, problems.read, logs.read, slo.read, apiTokens.read,
# auditLogs.read, oneAgents.read, activeGates.read, InstallerDownload,
# extensions.read, extensionConfigurations.read, extensionEnvironment.read,
# DTAQLAccess (USQL). Grant only what the tools you use need.
# DT_TOKEN=
DT_TOKEN_FILE=

# ---- Write token (optional) — enables the write tools when set --------------
# Use a SEPARATE, narrowly scoped token. Same "exactly one" rule.
# Scopes by tool family: settings.write, WriteConfig (dashboards),
# entities.write (tags), metrics.ingest, logs.ingest, events.ingest,
# bizevents.ingest, problems.write, apiTokens.write, slo.write,
# ExternalSyntheticIntegration, extensionConfigurations.write,
# extensionEnvironment.write.
# DT_WRITE_TOKEN=
# DT_WRITE_TOKEN_FILE=

# Directory for the write-tool audit log (JSONL, one file per day).
# Default: <cwd>/.audit
# DT_AUDIT_DIR=

# ---- Cluster token (optional) — only for /api/v1.0/onpremise/* reads --------
# and the dt-spec://cluster-v1 resource. Same "exactly one" rule.
# DT_CLUSTER_TOKEN=
# DT_CLUSTER_TOKEN_FILE=

# ---- TLS -------------------------------------------------------------------
# Set to "0" to disable certificate verification (self-signed localhost clusters).
# Any other value (or unset) = verification ON.
DT_TLS_VERIFY=1

# ---- Engine (dt-engine Go binary) ------------------------------------------
# Required by the engine-backed tools: dt_list_checks, dt_run_checks,
# dt_get_tag_snapshot, dt_extract_tag_signals, dt_simulate_tag_strategy,
# dt_audit_process_group_naming, dt_audit_host_naming, dt_audit_host_groups,
# dt_get_oneagent_versions, dt_get_activegate_versions, dt_get_api_tokens.
# Absolute path to the binary; default looks up `dt-engine` on PATH.
# DT_ENGINE_BIN=/usr/local/bin/dt-engine

# Where dt_run_checks materializes raw bundles. Default: <cwd>/.bundles
# DT_BUNDLE_DIR=

# How long (ms) the fetched entity graph (hosts/PGs/PGIs/services) is reused
# across the tag + naming analyzer tools. Default 600000 (10 min); 0 disables.
# DT_GRAPH_CACHE_TTL_MS=600000

# ---- HTTP client tuning ----------------------------------------------------
# DT_HTTP_TIMEOUT_MS=60000        # per-attempt timeout
# DT_HTTP_MAX_RETRIES=3           # GET / read-via-POST only; writes never retry
# DT_HTTP_BACKOFF_MS=1000         # initial backoff (full jitter, doubles per attempt)
# DT_HTTP_MAX_BACKOFF_MS=30000    # cap on a single backoff wait

# ---- Logging (JSONL on stderr; stdout is the MCP transport) ----------------
# DT_LOG_LEVEL=info               # trace | debug | info | warn | error
# DT_LOG_FILE=/var/log/dt-mcp.log           # mirror every log line to a file
# DT_ENGINE_LOG_FILE=/var/log/dt-engine.log # route engine-subprocess lines to their own file
